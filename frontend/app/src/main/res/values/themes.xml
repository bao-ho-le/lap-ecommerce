<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Frontend" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/premium_black</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/premium_light_gray</item>
        <item name="colorSecondary">@color/premium_gray</item>
        <item name="colorSurface">@color/premium_surface</item>
        <item name="colorSurfaceVariant">@color/premium_light_gray</item>
        <item name="colorOnSurface">@color/premium_black</item>
        <item name="colorOutline">@color/premium_border</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Frontend" parent="Base.Theme.Frontend" />

    <style name="Theme.Frontend.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>